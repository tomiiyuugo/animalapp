<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>家畜・動物 飼育記録アプリ (animalapp)</title>
    <!-- Tailwind CSS (スタイリング用) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js (体重推移グラフ用) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome (アイコン用) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- ヘッダー -->
    <header class="bg-emerald-600 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <i class="fa-solid font-bold fa-wheat-awn text-amber-300 text-2xl"></i>
                <h1 class="text-xl font-bold tracking-wide">飼育記録アプリ <span class="text-xs bg-emerald-700 px-2 py-0.5 rounded-full">animalapp</span></h1>
            </div>
            <!-- ユーザー情報 & ログアウト -->
            <div id="userInfo" class="hidden flex items-center space-x-3">
                <img id="userAvatar" class="w-8 h-8 rounded-full border-2 border-white" src="" alt="User Avatar">
                <span id="userName" class="text-sm font-medium hidden sm:inline"></span>
                <button id="logoutBtn" class="bg-emerald-700 hover:bg-emerald-800 text-xs px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1">
                    <i class="fa-solid fa-right-from-bracket"></i> ログアウト
                </button>
            </div>
        </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="flex-grow max-w-6xl w-full mx-auto p-4 sm:p-6">

        <!-- ログイン前画面 -->
        <div id="loginScreen" class="flex flex-col items-center justify-center py-16 px-4">
            <div class="bg-white p-8 rounded-2xl shadow-xl max-w-md w-full text-center border border-slate-100">
                <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-6 text-3xl">
                    <i class="fa-solid fa-cow"></i>
                </div>
                <h2 class="text-2xl font-bold mb-2 text-slate-800">飼育管理システムへ</h2>
                <p class="text-slate-600 text-sm mb-6">実習・飼育のデータ（鶏・牛・豚・ウサギ等）を安全に一元管理。ご利用にはGoogleアカウントでログインが必要です。</p>
                <button id="loginBtn" class="w-full bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold py-3 px-4 rounded-xl shadow-sm transition duration-200 flex items-center justify-center gap-3">
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    Googleでログイン
                </button>
            </div>
        </div>

        <!-- ログイン後画面 -->
        <div id="appScreen" class="hidden space-y-6">

            <!-- エラー・通知メッセージバー -->
            <div id="toastMessage" class="hidden p-4 rounded-xl text-sm font-medium transition-all duration-300"></div>

            <!-- 上部: 登録フォームと統計概要 -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- データ入力フォーム -->
                <div class="lg:col-span-1 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-pen-to-square text-emerald-600"></i> 新しい記録を登録
                    </h2>
                    <form id="recordForm" class="space-y-4">
                        <input type="hidden" id="editDocId" value="">

                        <!-- 動物名 (プルダウン + 直接入力) -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">動物名 <span class="text-red-500">*</span></label>
                            <select id="animalSelect" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                                <option value="牛">牛 (Cow)</option>
                                <option value="豚">豚 (Pig)</option>
                                <option value="鶏">鶏 (Chicken)</option>
                                <option value="ウサギ">ウサギ (Rabbit)</option>
                                <option value="羊">羊 (Sheep)</option>
                                <option value="custom">その他 (直接入力)</option>
                            </select>
                            <input type="text" id="customAnimal" class="hidden mt-2 w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-emerald-500" placeholder="動物名を入力">
                        </div>

                        <!-- 記録日 -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">記録日 <span class="text-red-500">*</span></label>
                            <input type="date" id="recordDate" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" required>
                        </div>

                        <!-- 体重 & 給餌量 (2列レイアウト) -->
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">体重 (kg) <span class="text-red-500">*</span></label>
                                <input type="number" step="0.01" min="0" id="weight" placeholder="例: 450.5" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" required>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">給餌量 (kg) <span class="text-red-500">*</span></label>
                                <input type="number" step="0.01" min="0" id="feedAmount" placeholder="例: 12.0" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" required>
                            </div>
                        </div>

                        <!-- メモ -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">メモ (様子・体調・気づき等)</label>
                            <textarea id="memo" rows="3" placeholder="毛並みが良い、食欲旺盛など" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none"></textarea>
                        </div>

                        <!-- 登録/更新ボタン -->
                        <div class="flex gap-2 pt-2">
                            <button type="button" id="cancelEditBtn" class="hidden w-1/3 bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-semibold py-2.5 rounded-lg transition">キャンセル</button>
                            <button type="submit" id="submitBtn" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold py-2.5 rounded-lg shadow transition flex items-center justify-center gap-2">
                                <i class="fa-solid fa-cloud-arrow-up"></i> <span id="submitBtnText">登録する</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- グラフ・集計エリア -->
                <div class="lg:col-span-2 space-y-6 flex flex-col">
                    <!-- 集計カード -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                            <p class="text-xs text-slate-500 font-medium">選択中の対象</p>
                            <p id="statsAnimalTarget" class="text-lg font-bold text-slate-800">全動物</p>
                        </div>
                        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                            <p class="text-xs text-slate-500 font-medium">総給餌量</p>
                            <p id="statsTotalFeed" class="text-lg font-bold text-emerald-600">0 kg</p>
                        </div>
                        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm col-span-2 sm:col-span-1">
                            <p class="text-xs text-slate-500 font-medium">全記録数</p>
                            <p id="statsTotalCount" class="text-lg font-bold text-indigo-600">0 件</p>
                        </div>
                    </div>

                    <!-- 体重推移グラフ -->
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex-grow flex flex-col justify-center">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-sm font-bold text-slate-700 flex items-center gap-2">
                                <i class="fa-solid fa-chart-line text-emerald-600"></i> 体重の推移 (kg)
                            </h3>
                            <span class="text-xs text-slate-400">※動物ごとに自動フィルタ</span>
                        </div>
                        <div class="relative w-full h-48 sm:h-64">
                            <canvas id="weightChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 下部: フィルター・検索バー & 履歴一覧 -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <!-- フィルターヘッダー -->
                <div class="p-4 sm:p-6 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row gap-4 justify-between items-center">
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-list-check text-emerald-600"></i> 飼育記録一覧
                    </h2>

                    <!-- 絞り込みと並び替え操作 -->
                    <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                        <!-- 動物フィルタ -->
                        <div class="flex items-center gap-1.5 bg-white border border-slate-300 rounded-lg px-3 py-1.5 text-xs shadow-sm">
                            <i class="fa-solid fa-filter text-slate-400"></i>
                            <select id="filterAnimal" class="bg-transparent focus:outline-none text-slate-700 font-medium">
                                <option value="ALL">すべての動物</option>
                                <option value="牛">牛</option>
                                <option value="豚">豚</option>
                                <option value="鶏">鶏</option>
                                <option value="ウサギ">ウサギ</option>
                                <option value="羊">羊</option>
                            </select>
                        </div>

                        <!-- 日付ソート -->
                        <div class="flex items-center gap-1.5 bg-white border border-slate-300 rounded-lg px-3 py-1.5 text-xs shadow-sm">
                            <i class="fa-solid fa-sort text-slate-400"></i>
                            <select id="sortOrder" class="bg-transparent focus:outline-none text-slate-700 font-medium">
                                <option value="desc">日付: 新しい順</option>
                                <option value="asc">日付: 古い順</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- 記録データリスト -->
                <div class="divide-y divide-slate-100" id="recordsList">
                    <!-- JSでリアルタイム表示 -->
                    <div class="p-8 text-center text-slate-400 text-sm">データ読み込み中...</div>
                </div>
            </div>

        </div>

    </main>

    <!-- フッター -->
    <footer class="bg-slate-100 border-t border-slate-200 text-center py-4 text-xs text-slate-500 mt-auto">
        &copy; 飼育記録管理アプリ (animalapp) - 実技試験提出用プロトタイプ
    </footer>

    <!-- Firebase SDK Imports (v11.6.1) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInWithCustomToken, signInAnonymously, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, updateDoc, deleteDoc, doc, onSnapshot, query, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // APP CONFIG & INITIALIZATION
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'animalapp-default';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            apiKey: "AIzaSyDummyKeyForFallbackPurposeOnly",
            authDomain: "animalapp-demo.firebaseapp.com",
            projectId: "animalapp-demo",
            storageBucket: "animalapp-demo.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:abcdef"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        // UI State Elements
        const loginScreen = document.getElementById('loginScreen');
        const appScreen = document.getElementById('appScreen');
        const userInfo = document.getElementById('userInfo');
        const userAvatar = document.getElementById('userAvatar');
        const userName = document.getElementById('userName');
        const loginBtn = document.getElementById('loginBtn');
        const logoutBtn = document.getElementById('logoutBtn');

        // Form Elements
        const recordForm = document.getElementById('recordForm');
        const editDocId = document.getElementById('editDocId');
        const animalSelect = document.getElementById('animalSelect');
        const customAnimal = document.getElementById('customAnimal');
        const recordDate = document.getElementById('recordDate');
        const weight = document.getElementById('weight');
        const feedAmount = document.getElementById('feedAmount');
        const memo = document.getElementById('memo');
        const submitBtnText = document.getElementById('submitBtnText');
        const cancelEditBtn = document.getElementById('cancelEditBtn');

        // Filter & Display Elements
        const filterAnimal = document.getElementById('filterAnimal');
        const sortOrder = document.getElementById('sortOrder');
        const recordsList = document.getElementById('recordsList');
        const statsAnimalTarget = document.getElementById('statsAnimalTarget');
        const statsTotalFeed = document.getElementById('statsTotalFeed');
        const statsTotalCount = document.getElementById('statsTotalCount');

        let currentUser = null;
        let unsubscribeSnapshot = null;
        let rawRecordsData = [];
        let chartInstance = null;

        // 初期日付を本日にセット
        recordDate.value = new Date().toISOString().split('T')[0];

        // 1. AUTHENTICATION HANDLERS
        // 初期認証設定 (自動ログイン・カスタムトークン対応)
        async function initAuth() {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                }
            } catch (err) {
                console.warn("Custom token auth failed, awaiting manual/anonymous login", err);
            }
        }
        initAuth();

        // Auth State Listener
        onAuthStateChanged(auth, (user) => {
            currentUser = user;
            if (user) {
                // ログイン時
                loginScreen.classList.add('hidden');
                appScreen.classList.remove('hidden');
                userInfo.classList.remove('hidden');
                userName.textContent = user.displayName || user.email || 'ユーザー';
                userAvatar.src = user.photoURL || `https://placehold.co/100x100/10b981/ffffff?text=${(user.displayName||'U').charAt(0)}`;
                
                // Firestoreのリアルタイム監視開始
                attachFirestoreListener();
            } else {
                // ログアウト時
                loginScreen.classList.remove('hidden');
                appScreen.classList.add('hidden');
                userInfo.classList.add('hidden');
                if (unsubscribeSnapshot) unsubscribeSnapshot();
            }
        });

        // Google ログインボタン
        loginBtn.addEventListener('click', async () => {
            const provider = new GoogleAuthProvider();
            try {
                await signInWithPopup(auth, provider);
                showToast("Googleアカウントでログインしました", "success");
            } catch (error) {
                console.error("Login Error:", error);
                // テスト用のフォールバック (認証エラー時に匿名ログインで試行)
                try {
                    await signInAnonymously(auth);
                    showToast("デモユーザーとしてログインしました", "info");
                } catch(e) {
                    showToast("ログインに失敗しました: " + error.message, "error");
                }
            }
        });

        // ログアウトボタン
        logoutBtn.addEventListener('click', async () => {
            try {
                await signOut(auth);
                showToast("ログアウトしました", "info");
            } catch (error) {
                showToast("ログアウトエラー: " + error.message, "error");
            }
        });

        // 2. FORM INTERACTION LOGIC
        animalSelect.addEventListener('change', () => {
            if (animalSelect.value === 'custom') {
                customAnimal.classList.remove('hidden');
                customAnimal.required = true;
            } else {
                customAnimal.classList.add('hidden');
                customAnimal.required = false;
            }
        });

        // キャンセルボタン (編集解除)
        cancelEditBtn.addEventListener('click', resetForm);

        function resetForm() {
            recordForm.reset();
            editDocId.value = '';
            recordDate.value = new Date().toISOString().split('T')[0];
            customAnimal.classList.add('hidden');
            submitBtnText.textContent = "登録する";
            cancelEditBtn.classList.add('hidden');
        }

        // 登録 / 更新フォーム送信
        recordForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!currentUser) return;

            const selectedAnimal = animalSelect.value === 'custom' ? customAnimal.value.trim() : animalSelect.value;
            const recordDateVal = recordDate.value;
            const weightVal = parseFloat(weight.value);
            const feedVal = parseFloat(feedAmount.value);
            const memoVal = memo.value.trim();

            // バリデーション
            if (!selectedAnimal || !recordDateVal || isNaN(weightVal) || isNaN(feedVal)) {
                showToast("すべての必須項目を正しく入力してください。", "error");
                return;
            }

            const docData = {
                animal: selectedAnimal,
                date: recordDateVal,
                weight: weightVal,
                feedAmount: feedVal,
                memo: memoVal,
                updatedAt: serverTimestamp()
            };

            // STRICT PATH REQUIREMENT: /artifacts/{appId}/users/{userId}/records
            const userColRef = collection(db, 'artifacts', appId, 'users', currentUser.uid, 'records');

            try {
                if (editDocId.value) {
                    // 既存編集
                    const targetDocRef = doc(db, 'artifacts', appId, 'users', currentUser.uid, 'records', editDocId.value);
                    await updateDoc(targetDocRef, docData);
                    showToast("記録を更新しました！", "success");
                } else {
                    // 新規登録
                    docData.createdAt = serverTimestamp();
                    await addDoc(userColRef, docData);
                    showToast("新しい記録を登録しました！", "success");
                }
                resetForm();
            } catch (err) {
                console.error("Firestore Save Error:", err);
                showToast("保存中にエラーが発生しました: " + err.message, "error");
            }
        });

        // 3. FIRESTORE REALTIME LISTENER
        function attachFirestoreListener() {
            if (!currentUser) return;

            // RULE 1 & 2: ルールに従う単純クエリ
            const userColRef = collection(db, 'artifacts', appId, 'users', currentUser.uid, 'records');

            unsubscribeSnapshot = onSnapshot(query(userColRef), (snapshot) => {
                rawRecordsData = [];
                snapshot.forEach((doc) => {
                    rawRecordsData.push({
                        id: doc.id,
                        ...doc.data()
                    });
                });
                // データを反映
                renderAppView();
            }, (error) => {
                console.error("Firestore Snapshot Error:", error);
                showToast("データの読み込みに失敗しました", "error");
            });
        }

        // フィルター & ソート 変更イベント
        filterAnimal.addEventListener('change', renderAppView);
        sortOrder.addEventListener('change', renderAppView);

        // 4. VIEW RENDER LOGIC
        function renderAppView() {
            const filterVal = filterAnimal.value;
            const sortVal = sortOrder.value;

            // 1. 動物名フィルタリング
            let filtered = rawRecordsData.filter(item => {
                if (filterVal === 'ALL') return true;
                return item.animal === filterVal;
            });

            // 2. 日付ソート (JavaScriptメモリ上処理)
            filtered.sort((a, b) => {
                const dateA = new Date(a.date);
                const dateB = new Date(b.date);
                return sortVal === 'desc' ? dateB - dateA : dateA - dateB;
            });

            // 3. 統計情報更新
            updateStats(filtered, filterVal);

            // 4. グラフ更新
            renderChart(filtered, filterVal);

            // 5. リストの描画
            renderRecordsList(filtered);
        }

        // 統計値の更新
        function updateStats(records, filterVal) {
            statsAnimalTarget.textContent = filterVal === 'ALL' ? '全動物' : filterVal;
            const totalFeed = records.reduce((acc, cur) => acc + (Number(cur.feedAmount) || 0), 0);
            statsTotalFeed.textContent = `${totalFeed.toFixed(1)} kg`;
            statsTotalCount.textContent = `${records.length} 件`;
        }

        // リスト描画（前回の記録と比較して体重変化表示付き）
        function renderRecordsList(records) {
            if (records.length === 0) {
                recordsList.innerHTML = `
                    <div class="p-12 text-center text-slate-400">
                        <i class="fa-solid fa-folder-open text-3xl mb-2 block"></i>
                        記録されているデータがありません。フォームから新しいデータを取り込んでください。
                    </div>`;
                return;
            }

            // 動物ごとに日付順にソートしたマップを用意（前回の体重との比較用）
            const animalHistoryMap = {};
            [...rawRecordsData].sort((a, b) => new Date(a.date) - new Date(b.date)).forEach(r => {
                if (!animalHistoryMap[r.animal]) animalHistoryMap[r.animal] = [];
                animalHistoryMap[r.animal].push(r);
            });

            let html = '';
            records.forEach(item => {
                // 同じ動物の全履歴における「前の記録」を取得
                const history = animalHistoryMap[item.animal] || [];
                const currentIndex = history.findIndex(h => h.id === item.id);
                let weightDiffBadge = '';

                if (currentIndex > 0) {
                    const prevWeight = history[currentIndex - 1].weight;
                    const diff = item.weight - prevWeight;

                    if (diff < 0) {
                        // 体重減少 (注意表示)
                        weightDiffBadge = `<span class="inline-flex items-center gap-1 bg-red-100 text-red-700 text-xs px-2 py-0.5 rounded-full font-bold">
                            <i class="fa-solid fa-arrow-trend-down"></i> ${diff.toFixed(1)}kg
                        </span>`;
                    } else if (diff > 0) {
                        // 体重増加
                        weightDiffBadge = `<span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-700 text-xs px-2 py-0.5 rounded-full font-semibold">
                            <i class="fa-solid fa-arrow-trend-up"></i> +${diff.toFixed(1)}kg
                        </span>`;
                    } else {
                        weightDiffBadge = `<span class="text-xs text-slate-400">±0kg</span>`;
                    }
                }

                html += `
                <div class="p-4 sm:p-5 hover:bg-slate-50/80 transition flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="space-y-1.5 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="bg-slate-800 text-white text-xs font-bold px-2.5 py-1 rounded-md">${escapeHtml(item.animal)}</span>
                            <span class="text-sm font-semibold text-slate-700">${item.date}</span>
                            ${weightDiffBadge}
                        </div>
                        <div class="flex flex-wrap gap-4 text-sm text-slate-600">
                            <div><span class="text-xs text-slate-400">体重:</span> <strong class="text-slate-800 font-bold">${item.weight}</strong> kg</div>
                            <div><span class="text-xs text-slate-400">給餌量:</span> <strong class="text-slate-800 font-bold">${item.feedAmount}</strong> kg</div>
                        </div>
                        ${item.memo ? `<p class="text-xs text-slate-500 bg-slate-100/70 p-2 rounded-lg mt-1"><i class="fa-regular fa-comment text-slate-400 mr-1"></i>${escapeHtml(item.memo)}</p>` : ''}
                    </div>

                    <!-- 編集 / 削除ボタン -->
                    <div class="flex items-center gap-2 self-end sm:self-center">
                        <button onclick="window.editRecord('${item.id}')" class="text-slate-500 hover:text-emerald-600 hover:bg-emerald-50 p-2 rounded-lg transition" title="編集">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button onclick="window.deleteRecord('${item.id}')" class="text-slate-500 hover:text-red-600 hover:bg-red-50 p-2 rounded-lg transition" title="削除">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                </div>`;
            });

            recordsList.innerHTML = html;
        }

        // 5. GRAPH RENDERING (Chart.js)
        function renderChart(records, filterVal) {
            const ctx = document.getElementById('weightChart').getContext('2d');

            // グラフ用に古い順に並び替え
            const sortedForChart = [...records].sort((a, b) => new Date(a.date) - new Date(b.date));

            const labels = sortedForChart.map(r => `${r.date} (${r.animal})`);
            const dataPoints = sortedForChart.map(r => r.weight);

            if (chartInstance) {
                chartInstance.destroy();
            }

            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: '体重 (kg)',
                        data: dataPoints,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointBackgroundColor: '#059669',
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: false,
                            grid: { color: '#f1f5f9' },
                            ticks: { font: { size: 10 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 10 } }
                        }
                    }
                }
            });
        }

        // 6. EDIT & DELETE ACTIONS (Exposed to Global window)
        window.editRecord = function(docId) {
            const record = rawRecordsData.find(r => r.id === docId);
            if (!record) return;

            editDocId.value = record.id;
            
            // プルダウンのセット
            const standardAnimals = ['牛', '豚', '鶏', 'ウサギ', '羊'];
            if (standardAnimals.includes(record.animal)) {
                animalSelect.value = record.animal;
                customAnimal.classList.add('hidden');
            } else {
                animalSelect.value = 'custom';
                customAnimal.value = record.animal;
                customAnimal.classList.remove('hidden');
            }

            recordDate.value = record.date;
            weight.value = record.weight;
            feedAmount.value = record.feedAmount;
            memo.value = record.memo || '';

            submitBtnText.textContent = "更新する";
            cancelEditBtn.classList.remove('hidden');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        };

        window.deleteRecord = async function(docId) {
            if (!currentUser) return;
            if (!confirm("この飼育記録を削除してもよろしいですか？")) return;

            try {
                const targetDocRef = doc(db, 'artifacts', appId, 'users', currentUser.uid, 'records', docId);
                await deleteDoc(targetDocRef);
                showToast("記録を削除しました", "info");
            } catch (err) {
                console.error("Delete error:", err);
                showToast("削除できませんでした: " + err.message, "error");
            }
        };

        // 7. UTILITIES
        function showToast(msg, type = "info") {
            const toast = document.getElementById('toastMessage');
            toast.textContent = msg;
            toast.className = "p-4 rounded-xl text-sm font-medium transition-all duration-300 block ";
            
            if (type === "success") toast.classList.add("bg-emerald-100", "text-emerald-800", "border", "border-emerald-200");
            else if (type === "error") toast.classList.add("bg-red-100", "text-red-800", "border", "border-red-200");
            else toast.classList.add("bg-slate-800", "text-white");

            setTimeout(() => {
                toast.classList.add("hidden");
            }, 3500);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>"']/g, function(m) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                }[m];
            });
        }
    </script>
</body>
</html>
 
 
